# ============================================================
# ZN-M2 OpenWrt Build Configuration - MINIMAL DAE EDITION
# Target: Qualcomm IPQ6000 (qualcommax/ipq60xx/zn_m2)
# Source: VIKINGYFY/ImmortalWrt main (NSS Full Support)
# Kernel: 6.18 with eBPF/BTF enabled (required by dae)
# Features: dae v2.1.1 (pinned, kdae) + daed (official web UI) + ttyd + tailscale
# Memory: 512MB RAM, 128MB NAND (~94MB usable)
# NOTE: No files/ overlay is applied - OpenWrt defaults are used
#       (LAN 192.168.1.1, DHCP on WAN). Configure PPPoE in LuCI.
# ============================================================

# --- Target ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

# --- Kernel options ---
# 6.18 from VIKINGYFY/ImmortalWrt main (NSS full support)
CONFIG_KERNEL_ZRAM=y
CONFIG_KERNEL_ZRAM_WRITEBACK=y
CONFIG_KERNEL_ZRAM_MEMORY_LIMIT=256
CONFIG_KERNEL_SWAP=y
CONFIG_KERNEL_CGROUPS=y

# DEVEL: expose developer options so the BPF_TOOLCHAIN choice
# (prompt "BPF toolchain" if DEVEL) is settable; without it,
# make defconfig silently drops CONFIG_BPF_TOOLCHAIN_HOST.
CONFIG_DEVEL=y

# --- eBPF / BTF (REQUIRED by dae) ---
# dae needs BTF debug info + cgroup-bpf + BPF events + XDP sockets.
# CONFIG_BPF_TOOLCHAIN_HOST builds host clang with the BPF backend.
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y

# --- Filesystem ---
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
# CONFIG_TARGET_ROOTFS_EXT4 is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set

# --- Image options ---
CONFIG_TARGET_ROOTFS_PARTSIZE=80

# --- Base system ---
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_kernel=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_usign=y

# --- IPv6 ---
# CONFIG_PACKAGE_ip6tables-nft is not set
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# --- LuCI Web Interface ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y

# Default bootstrap theme (minimal build, no Argon)
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-argon is not set

# --- Chinese (Simplified) ---
# CRITICAL: current LuCI gates every luci-i18n-*-zh-cn package behind a
# CONFIG_LUCI_LANG_* switch (see feeds/luci/luci.mk: DEFAULT:=LUCI_LANG_$(lang)).
# Without CONFIG_LUCI_LANG_zh_Hans=y those packages do not exist and
# `make defconfig` silently drops them -> English-only UI.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# LuCI applications - system
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# --- DAE (transparent proxy) ---
# dae core + LuCI management UI, cloned from ysuolmai/luci-app-dae
# into package/ by diy-part2.sh (before make defconfig).
# dae pulls its own deps: ca-bundle, kmod-sched-*, kmod-xdp-sockets-diag,
# kmod-veth, v2ray-geoip, v2ray-geosite (all in standard feeds).
CONFIG_PACKAGE_dae=y
# daed (official dae web UI backend) + luci-app-daed from feeds
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

# --- Tailscale (remote management over tailnet) ---
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y

# --- Network tools (minimal: fw4/nftables only, no iptables compat) ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
# CONFIG_PACKAGE_iptables-nft is not set
# CONFIG_PACKAGE_kmod-ipt-core is not set
CONFIG_PACKAGE_kmod-nf-iptables=y
CONFIG_PACKAGE_kmod-nft-compat=y
# CONFIG_PACKAGE_kmod-ipt-conntrack is not set
# CONFIG_PACKAGE_kmod-ipt-nat is not set
# CONFIG_PACKAGE_kmod-ipt-nathelper is not set
# CONFIG_PACKAGE_kmod-nf-nathelper is not set
# CONFIG_PACKAGE_kmod-nf-nathelper-extra is not set

# Multicast / IGMP kernel modules
# CONFIG_PACKAGE_kmod-ipt-igmp is not set
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y

# VLAN support
CONFIG_PACKAGE_kmod-8021q=y
# CONFIG_PACKAGE_kmod-gpio-nxp-74hc164 is not set

# Bridge / network
CONFIG_PACKAGE_kmod-bridge=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# PPPoE (broadband dialing - configure your own account in LuCI)
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y

# --- WiFi ---
# ENABLED: user wants WiFi AP on ZN-M2.
# Upstream DEFAULT_PACKAGES already includes these; listed explicitly
# for clarity / verification. kmod-mac80211, kmod-cfg80211 and
# wireless-regdb are pulled in automatically as dependencies.
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
# CONFIG_PACKAGE_kmod-ath11k-pci is not set (ZN-M2 WiFi is AHB, no PCIe)
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
CONFIG_PACKAGE_wpad-openssl=y

# --- Utilities (minimal: uclient-fetch only, curl/wget removed) ---
# uclient-fetch: used by apk/opkg for downloads (keep only this one)
# busybox base64 applet: dae's list-nodes.sh needs it to decode
# base64 node subscriptions (fallback path when dae is stopped)
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_BASE64=y
# CONFIG_PACKAGE_curl is not set
# CONFIG_PACKAGE_wget-ssl is not set

# --- SSL ---
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libopenssl=y

# --- NSS / Hardware acceleration ---
# VIKINGYFY/ImmortalWrt main puts the FULL NSS stack into DEFAULT_PACKAGES of
# target/linux/qualcommax/Makefile, so it is enabled automatically:
#   kmod-qca-nss-drv (core, pulls nss-firmware) + all kmod-qca-nss-drv-* submodules
#   kmod-qca-nss-ecm (ECM connection manager = the actual offload engine)
#   kmod-qca-nss-dp (data plane ethernet driver, one netdev per port)
#   kmod-qca-ssdk (switch SDK), kmod-qca-nss-crypto
# They are listed here explicitly as well for clarity / verification.
CONFIG_PACKAGE_kmod-qca-nss-drv=y
# 2026-10-16: DISABLE ECM (offload engine) - IPv4 LAN was completely dead
# (no DHCP/ping/SSH) on builds with ECM enabled, while openwrt.ai Kwrt
# (no NSS) works fine on the same hardware. Keep nss-dp (data plane driver)
# for Ethernet ports, only remove the connection offloader.
# CONFIG_PACKAGE_kmod-qca-nss-ecm is not set
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
# CONFIG_PACKAGE_kmod-qca-nss-crypto is not set
CONFIG_PACKAGE_nss-firmware=y

# NSS driver submodules
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y

# NOTE: when dae's transparent proxy is active, disable hardware flow
# offloading to avoid conflicts:
#   /etc/init.d/qca-nss-ecm stop && /etc/init.d/qca-nss-ecm disable

# Port status: each dp port is an independent netdev labelled in the DTS
# (dp4=lan1, dp2=lan2, dp1=lan3, dp5=wan), so LuCI shows all 4 ports.

# --- Disabled: everything not needed for the minimal dae build ---
# No passwall / openclash (dae replaces them - do not run two transparent
# proxies at once), no rtp2httpd, no gecoosac, no UPnP, no turboacc,
# no fullcone NAT, no Argon theme, no nano, no USB storage.
# 2026-10-17 v4 slim: also disable redundant packages from DEFAULT_PACKAGES
# (tunnel modules, fs drivers, etc. per redundancy check)
# CONFIG_PACKAGE_kmod-bonding is not set
# CONFIG_PACKAGE_kmod-gre is not set
# CONFIG_PACKAGE_kmod-pptp is not set
# CONFIG_PACKAGE_kmod-vxlan is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_passwall is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_rtp2httpd is not set
# CONFIG_PACKAGE_luci-app-rtp2httpd is not set
# CONFIG_PACKAGE_gecoosac is not set
# CONFIG_PACKAGE_luci-app-gecoosac is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_kmod-nft-fullcone is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
# --- ZRAM swap (anti-freeze: compress RAM when memory is tight) ---
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# --- Web terminal (for remote management via LuCI) ---
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-nfs is not set

# --- USB (disabled to save space, enable if needed) ---
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-extras is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_kmod-nls-cp437 is not set
# CONFIG_PACKAGE_kmod-nls-iso8859-1 is not set

# --- DDNS: DISABLED (not needed) ---
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set
